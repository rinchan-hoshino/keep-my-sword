{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.rinchan.keepmysword.fabric.KeepMySwordFabric"
    ],
    "modmenu": [
      "dev.rinchan.keepmysword.fabric.KeepMySwordModMenu"
    ]
  },
  "mixins": [
    "keep_my_sword.mixins.json",
    {
      "config": "keep_my_sword.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  },
  "icon": "icon.png",
  "contact": {
    "homepage": "https://modrinth.com/mod/keep-my-sword",
    "sources": "https://github.com/rinchan-hoshino/keep-my-sword",
    "issues": "https://github.com/rinchan-hoshino/keep-my-sword/issues"
  }
}
