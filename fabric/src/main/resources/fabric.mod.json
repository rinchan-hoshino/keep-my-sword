{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": { "main": ["dev.rinchan.keepmysword.fabric.KeepMySwordFabric"] },
  "mixins": [
    "keep_my_sword.mixins.json",
    "keep_my_sword.fabric.mixins.json",
    {
      "config": "keep_my_sword.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "rinlib": ">=${rinlib_version}"
  },
  "icon": "icon.png",
  "contact": {
    "homepage": "https://modrinth.com/mod/keep-my-sword",
    "sources": "https://github.com/rinchan-hoshino/keep-my-sword",
    "issues": "https://github.com/rinchan-hoshino/keep-my-sword/issues"
  }
}
